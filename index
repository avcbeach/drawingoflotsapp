/* full screen */
const stage=document.getElementById("stage"), fsBtn=document.getElementById("fsBtn");
const mainEl=document.getElementById("main");
function isFs(){ return stage.classList.contains("fs")||mainEl.classList.contains("fsside"); }
function enterFs(){
  if(sideActive()) mainEl.classList.add("fsside"); else stage.classList.add("fs");
  document.body.classList.add("noscroll"); fsBtn.textContent="Exit full screen";
  try{ const r=document.documentElement.requestFullscreen?.(); if(r&&r.catch) r.catch(()=>{}); }catch(e){}
