/* ---------- download draw results ---------- */
function drawCsv(){
  const q=v=>{ v=String(v??""); return /[",\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v; };
  const ev=(document.getElementById("eventName")?.textContent||"").trim();
  const rows=[];
  if(ev) rows.push([ev]);
  rows.push(["Division",div==="men"?"Men":"Women"]);
  rows.push(["Exported",new Date().toLocaleString()]);
  rows.push([]);
  rows.push(["Seed","Pool","Team","Source",FMT.firstHead+" match","Date & time","Court","Opponent seed","Opponent pool","Opponent team"]);
  const matchOf={}; R16.forEach(([id,a,b])=>{matchOf[a]=[id,b];matchOf[b]=[id,a];});
  const src=n=>FIXED[n]?"Locked (pool winner)":(drawNums().length>1?"Draw "+drawNums().find(d=>DRAWS[d].seeds.includes(n)):"Draw");
  for(let n=1;n<=FMT.nSeeds;n++){
    const t=seedTeam(n), [mid,opp]=matchOf[n], ot=seedTeam(opp);
    const sc=schedOf(mid);
    rows.push([n,t||"",t?teamName(t):"Not drawn",src(n),mLabel(mid),whenText(mid),sc.c||"",opp,ot||"",ot?teamName(ot):"Not drawn"]);
  }
  rows.push([]);
  rows.push(["Draw order","Seed","Pool","Team"]);
  state.log.forEach((l,i)=>rows.push([i+1,l.seed,l.team,teamName(l.team)]));
  return "\ufeff"+rows.map(r=>r.map(q).join(",")).join("\r\n");
}
document.getElementById("dlBtn").onclick=async()=>{
  const csv=drawCsv();
  const stamp=new Date().toISOString().slice(0,10);
  const filename=`${FMT.short}-draw-${div}-${stamp}.csv`;
  let dl=null;
  try{ if(window.claude&&window.claude.use) dl=await window.claude.use("downloads"); }catch(e){}
  if(dl){
    try{ await dl.save({filename,data:csv}); toast("Saved"); }
    catch(e){ const c=e&&e.code;
      if(c==="declined") return;
      if(c==="rate_limited"){ toast("A save prompt is already open"); return; }
      toast("Download isn't available here — use Copy summary instead"); }
    return;
  }
  try{
    const url=URL.createObjectURL(new Blob([csv],{type:"text/csv;charset=utf-8"}));
    const a=document.createElement("a"); a.href=url; a.download=filename; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),2000);
  }catch(e){ toast("Download isn't available here — use Copy summary instead"); }
};

/* ---------- export bracket PDF ---------- */
function buildBracketPdf(){
  const { jsPDF } = window.jspdf;
  const doc=new jsPDF({orientation:"landscape",unit:"mm",format:"a4"});
  const M=resolve();
  const INK=[18,50,74], MUTED=[140,154,166], RULE=[205,189,158], BLUE=[47,111,219], BALL=[245,183,0], SAND=[237,227,207];
  const ev=(document.getElementById("eventName")?.textContent||"Final Phase · Round of 16").trim().replace(/·/g,"-");
  const divName=div==="men"?"Men":"Women";
  doc.setTextColor(...INK); doc.setFont("helvetica","bold"); doc.setFontSize(20);
  doc.text(divName+" - "+FMT.name+" Bracket",10,14);
  doc.setFont("helvetica","normal"); doc.setFontSize(9); doc.setTextColor(...MUTED);
  doc.text(ev,10,19.5);
  const logo=getLogo(); let logoW=0;
  if(logo){
    const maxH=16, maxW=48; let h=maxH, w=logo.w/logo.h*h; if(w>maxW){ w=maxW; h=logo.h/logo.w*w; }
    try{ doc.addImage(logo.src,"PNG",287-w,5+(maxH-h)/2,w,h); logoW=w+4; }catch(e){}
  }
  doc.text("Exported "+new Date().toLocaleString(),287-logoW,19.5,{align:"right"});

  const seedOf={}; for(let i=1;i<=FMT.nSeeds;i++){const t=seedTeam(i); if(t) seedOf[t]=i;}
  const rounds=[R16.map(r=>r[0])]; const heads=[FMT.firstHead];
  if(QF.length){ rounds.push(QF.map(r=>r[0])); heads.push("QF"); }
  rounds.push(SF.map(r=>r[0])); heads.push("SF");
  const cols=rounds.length===3
    ?[{x:10,w:66,h:heads[0]},{x:84,w:62,h:heads[1]},{x:154,w:62,h:heads[2]},{x:224,w:63,h:"Final"}]
    :[{x:10,w:80,h:heads[0]},{x:108,w:80,h:heads[1]},{x:206,w:81,h:"Final"}];
  const top=32, bottom=204, rowH=6.2, boxH=rowH*2;
  doc.setFont("helvetica","bold"); doc.setFontSize(11); doc.setTextColor(...INK); doc.setDrawColor(...INK); doc.setLineWidth(.6);
  cols.forEach(c=>{doc.text(c.h,c.x,27); doc.line(c.x,28.5,c.x+c.w,28.5);});

  function fit(txt,maxW,size){
    doc.setFontSize(size); let t=txt;
    while(doc.getTextWidth(t)>maxW && size>5.5){ size-=.3; doc.setFontSize(size); }
    while(doc.getTextWidth(t)>maxW && t.length>3){ t=t.slice(0,-2)+"…"; }
    return t;
  }
  function row(x,y,w,code,seed,m,placeholder){
    const win=code&&m.winner===code, lose=code&&m.winner&&!win;
    if(win){doc.setFillColor(...BALL); doc.rect(x,y,w,rowH,"F");}
    doc.setFont("helvetica","bold"); doc.setFontSize(8);
    doc.setTextColor(...(win?[59,42,0]:BLUE)); if(seed) doc.text(String(seed),x+5.5,y+4.2,{align:"right"});
    doc.setTextColor(...(win?[59,42,0]:lose?MUTED:INK));
    doc.setFontSize(7.5); doc.text(code||"-",x+7.2,y+4.2);
    doc.setFont("helvetica",win?"bold":"normal");
    const nm=code?teamName(code):placeholder;
    if(!code) doc.setTextColor(...MUTED);
    doc.text(fit(nm,w-17.5,7.5),x+15.5,y+4.2);
  }
  function box(id,label,x,cy,w){
    const m=M[id], y=cy-rowH;
    doc.setFont("helvetica","bold"); doc.setFontSize(7); doc.setTextColor(...MUTED);
    doc.text(label,x,y-1.2);
    const sc=(state.scores[id]||"").trim();
    let scW=0;
    if(sc){ doc.setFont("helvetica","normal"); const st=fit(sc,w*0.38,7); doc.text(st,x+w,y-1.2,{align:"right"}); scW=doc.getTextWidth(st)+2; }
    const wh=schedText(id).replace(/·/g,"|");
    if(wh){ doc.setFont("helvetica","bold"); doc.setFontSize(7); const lw=doc.getTextWidth(label)+2;
      doc.setFont("helvetica","normal"); doc.setTextColor(...INK); doc.text(fit(wh,w-lw-scW,7),x+lw,y-1.2); doc.setTextColor(...MUTED); }
    doc.setFillColor(255,252,245); doc.setDrawColor(...RULE); doc.setLineWidth(.3);
    doc.roundedRect(x,y,w,boxH,1.2,1.2,"FD");
    row(x,y,w,m.a,m.sa,m,m.sa?"Awaiting draw":"Awaiting result");
    row(x,y+rowH,w,m.b,m.sb,m,m.sb?"Awaiting draw":"Awaiting result");
    doc.setDrawColor(...RULE); doc.line(x,y+rowH,x+w,y+rowH);
    doc.roundedRect(x,y,w,boxH,1.2,1.2,"S");
    if(FIRSTSET.has(id)&&m.a&&m.b&&poolOf(m.a)===poolOf(m.b)){ doc.setDrawColor(181,58,46); doc.setLineWidth(.6); doc.roundedRect(x,y,w,boxH,1.2,1.2,"S"); }
  }
  const slot=(bottom-top)/rounds[0].length;
  const centers=[rounds[0].map((_,i)=>top+slot*i+slot/2+2)];
  for(let r=1;r<rounds.length;r++) centers.push(rounds[r].map((_,i)=>(centers[r-1][2*i]+centers[r-1][2*i+1])/2));
  const sfc=centers[centers.length-1];
  function connect(c1,c2,cOut,xFrom,xTo){
    const mid=(xFrom+xTo)/2; doc.setDrawColor(...RULE); doc.setLineWidth(.4);
    doc.line(xFrom,c1,mid,c1); doc.line(xFrom,c2,mid,c2); doc.line(mid,c1,mid,c2); doc.line(mid,cOut,xTo,cOut);
  }
  for(let r=1;r<rounds.length;r++) for(let i=0;i<rounds[r].length;i++)
    connect(centers[r-1][2*i],centers[r-1][2*i+1],centers[r][i],cols[r-1].x+cols[r-1].w,cols[r].x);
  rounds.forEach((ids,r)=>ids.forEach((id,i)=>box(id,mLabel(id),cols[r].x,centers[r][i],cols[r].w)));
  const lastC=cols[rounds.length-1], finC=cols[rounds.length];
  const fX=finC.x, fW=finC.w, goldC=(sfc[0]+sfc[1])/2-14, bronzeC=goldC+34;
  doc.setDrawColor(...RULE); doc.setLineWidth(.4);
  const sfR=lastC.x+lastC.w, midF=(sfR+fX)/2;
  doc.line(sfR,sfc[0],midF,sfc[0]); doc.line(sfR,sfc[1],midF,sfc[1]); doc.line(midF,sfc[0],midF,sfc[1]); doc.line(midF,goldC,fX,goldC);
  doc.setFont("helvetica","bold"); doc.setFontSize(9); doc.setTextColor(...INK);
  doc.text("Gold medal match",fX,goldC-rowH-5.5);
  box("F1",mLabel("F1"),fX,goldC,fW);
  doc.setFont("helvetica","bold"); doc.setFontSize(9); doc.setTextColor(...INK);
  doc.text("Bronze medal match",fX,bronzeC-rowH-5.5);
  box("F3",mLabel("F3"),fX,bronzeC,fW);
  let py=bronzeC+rowH+12;
  doc.setFillColor(...SAND); doc.roundedRect(fX,py-5,fW,24,1.5,1.5,"F");
  [["Gold",M.F1.winner],["Silver",M.F1.loser],["Bronze",M.F3.winner]].forEach(([k,c],i)=>{
    const y=py+i*6.8;
    doc.setFont("helvetica","bold"); doc.setFontSize(9); doc.setTextColor(...INK); doc.text(k,fX+3,y);
    doc.setFont("helvetica","normal"); doc.setFontSize(8);
    doc.setTextColor(...(c?INK:MUTED)); doc.text(c?fit(c+" "+teamName(c),fW-22,8):"-",fX+19,y);
  });
  return doc;
}
document.getElementById("pdfBtn").onclick=async()=>{
  if(!(window.jspdf&&window.jspdf.jsPDF)){ toast("PDF library needs internet — opening print instead"); setTimeout(()=>window.print(),600); return; }
  let blob;
  try{ blob=buildBracketPdf().output("blob"); }catch(e){ toast("Couldn't build the PDF"); return; }
  const filename=`${FMT.short}-bracket-${div}-${new Date().toISOString().slice(0,10)}.pdf`;
  let dl=null;
  try{ if(window.claude&&window.claude.use) dl=await window.claude.use("downloads"); }catch(e){}
  if(dl){
    try{ await dl.save({filename,data:blob}); toast("Saved"); }
    catch(e){ const c=e&&e.code; if(c==="declined") return;
      if(c==="rate_limited"){ toast("A save prompt is already open"); return; }
      toast("Download isn't available here"); }
    return;
  }
  const url=URL.createObjectURL(blob); const a=document.createElement("a");
  a.href=url; a.download=filename; document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),3000);
};

/* ---------- logo ---------- */
const LOGOKEY="r16-template-logo";
function getLogo(){ try{ const v=JSON.parse(localStorage.getItem(LOGOKEY)||"null"); return v&&v.src?v:null; }catch(e){ return null; } }
function renderLogo(){
  const l=getLogo(), el=document.getElementById("logoPrev");
  el.innerHTML=l?`<img src="${l.src}" alt="Logo preview">`:`<span class="muted">No logo</span>`;
  document.getElementById("logoClear").disabled=!l;
}
document.getElementById("logoFile").addEventListener("change",e=>{
  const file=e.target.files&&e.target.files[0]; e.target.value="";
  if(!file) return;
  const rd=new FileReader();
  rd.onload=()=>{
    const img=new Image();
    img.onload=()=>{
      const MAX=600, w0=img.naturalWidth||MAX, h0=img.naturalHeight||MAX, k=Math.min(1,MAX/Math.max(w0,h0));
      const cv=document.createElement("canvas"); cv.width=Math.max(1,Math.round(w0*k)); cv.height=Math.max(1,Math.round(h0*k));
      cv.getContext("2d").drawImage(img,0,0,cv.width,cv.height);
      const src=cv.toDataURL("image/png");
      try{ localStorage.setItem(LOGOKEY,JSON.stringify({src,w:cv.width,h:cv.height})); toast("Logo added"); }
      catch(err){ toast("Logo is too large to keep — try a smaller image"); }
      renderLogo();
    };
    img.onerror=()=>toast("Couldn't read that image");
    img.src=rd.result;
  };
  rd.readAsDataURL(file);
});
document.getElementById("logoClear").onclick=()=>{ try{ localStorage.removeItem(LOGOKEY); }catch(e){} renderLogo(); };
renderLogo();
/* ---------- copy summary ---------- */
document.getElementById("copyBtn").onclick=async()=>{
  const M=resolve(), L=[];
  const nm=c=>c?`${c} ${teamName(c)}`:"TBD";
  L.push((document.getElementById("eventName").textContent)+" — "+div.toUpperCase());
  L.push("\nSeeds:"); for(let i=1;i<=FMT.nSeeds;i++) L.push(`  ${i}. ${nm(seedTeam(i))}`);
  const line=(id,lab)=>{const m=M[id], w=schedText(id);L.push(`  ${lab}${w?` [${w}]`:""}: ${nm(m.a)} vs ${nm(m.b)}${m.winner?`  → ${m.winner}`:""}${state.scores[id]?` (${state.scores[id]})`:""}`);};
  L.push("\n"+FMT.firstHead+":"); R16.forEach(([id])=>line(id,mLabel(id)));
  if(QF.length){ L.push("\nQF:"); QF.forEach(([id])=>line(id,mLabel(id))); }
  L.push("\nSF:"); SF.forEach(([id])=>line(id,mLabel(id)));
  L.push("\nFinals:"); line("F1","Gold "+mLabel("F1")); line("F3","Bronze "+mLabel("F3"));
  const txt=L.join("\n");
  try{ await navigator.clipboard.writeText(txt); toast("Copied"); }
  catch(e){ const ta=document.createElement("textarea");ta.value=txt;document.body.appendChild(ta);ta.select();
    try{document.execCommand("copy");toast("Copied");}catch(_){toast("Copy is not supported in this browser");} ta.remove(); }
};

function toast(m){const t=document.getElementById("toast");t.textContent=m;t.classList.add("show");clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.remove("show"),1600);}
function esc(s){return String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));}

function refresh(flashSeed){ renderSeeds(flashSeed); renderBracket(); drawWheel(); updateSpin(); renderTarget(); }

function sideActive(){ return document.getElementById("main").classList.contains("side") && matchMedia("(min-width: 1100px)").matches; }
function setLayout(l){
  if(typeof exitFs==="function") exitFs();
  document.getElementById("main").classList.toggle("side",l==="side");
  document.querySelectorAll("#layoutSeg button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.layout===l));
  try{ localStorage.setItem("r16-template-layout",l); }catch(e){}
}
document.querySelectorAll("#layoutSeg button").forEach(b=>b.onclick=()=>setLayout(b.dataset.layout));
try{ setLayout(localStorage.getItem("r16-template-layout")==="side"?"side":"stack"); }catch(e){ setLayout("stack"); }
const EVKEY="r16-template-event";
function renderEvent(){ let v=""; try{ v=localStorage.getItem(EVKEY)||""; }catch(e){}
  document.getElementById("eventName").textContent=v||"Final Phase · "+FMT.name;
  document.getElementById("eventInput").value=v; }
document.getElementById("eventInput").addEventListener("change",e=>{ try{ localStorage.setItem(EVKEY,e.target.value.trim()); }catch(_){} renderEvent(); });
renderEvent();
function setDiv(d){
  if(spinning) return;
  exitFs();
  div=d; base=DIVISIONS[d]; state=load(); drawer=null;
  applyFormat(state.format==="qf"?"qf":"r16"); currentDraw=1; renderFormatUI(); renderEvent();
  try{ localStorage.setItem("r16-template-tab",d); }catch(e){}
  document.querySelectorAll(".tab").forEach(t=>t.setAttribute("aria-selected",t.dataset.div===d));
  document.getElementById("divTitle").textContent=d==="men"?"Men":"Women";
  document.title=FMT.short+" Bracket · "+(d==="men"?"Men":"Women");
  renderTeamEdit(); renderMode(); setDraw(drawNums().find(x=>!drawDone(x))||1); refresh();
  const ed=document.querySelector(".teamsedit details");
  if(ed && !Object.keys(state.names).length && !Object.keys(base.teams).length) ed.open=true;
}
document.querySelectorAll(".tab").forEach(t=>t.onclick=()=>setDiv(t.dataset.div));
setDiv(div);
if(document.fonts&&document.fonts.ready) document.fonts.ready.then(drawWheel);
matchMedia("(prefers-color-scheme: dark)").addEventListener?.("change",drawWheel);
})();
